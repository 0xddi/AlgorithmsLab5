<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GraphLab.Views"
        x:Class="GraphLab.MainWindow"
        Title="GraphLab — визуальные алгоритмы на графах"
        Width="1440" Height="900" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FontFamily="Inter"
        RequestedThemeVariant="Dark">
    <Window.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#0A1020" Offset="0" />
            <GradientStop Color="#070B14" Offset="0.55" />
            <GradientStop Color="#0B1224" Offset="1" />
        </LinearGradientBrush>
    </Window.Background>

    <Viewbox Stretch="Uniform" StretchDirection="Both">
        <Grid Width="1440" Height="900" RowDefinitions="Auto,Auto,*,Auto">
        <Grid Grid.Row="0" Margin="22,14,22,6" ColumnDefinitions="Auto,*,Auto">
            <Border Width="48" Height="48" CornerRadius="14" BorderBrush="#2B4A6F" BorderThickness="1"
                    Background="#101D31" VerticalAlignment="Center">
                <Viewbox Width="30" Height="30">
                    <Canvas Width="44" Height="44">
                        <Path Data="M 7,35 L 20,9 L 38,22 M 20,9 L 38,35 M 7,35 L 20,9"
                              Stroke="#22D3EE" StrokeThickness="2" Opacity="0.8" />
                        <Ellipse Canvas.Left="3" Canvas.Top="31" Width="9" Height="9" Fill="#34D399" />
                        <Ellipse Canvas.Left="16" Canvas.Top="5" Width="9" Height="9" Fill="#818CF8" />
                        <Ellipse Canvas.Left="34" Canvas.Top="18" Width="9" Height="9" Fill="#22D3EE" />
                        <Ellipse Canvas.Left="34" Canvas.Top="31" Width="9" Height="9" Fill="#F472B6" />
                    </Canvas>
                </Viewbox>
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="1">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="GraphLab" FontSize="25" FontWeight="Bold">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                <GradientStop Color="#67E8F9" Offset="0" />
                                <GradientStop Color="#A5B4FC" Offset="0.55" />
                                <GradientStop Color="#F9A8D4" Offset="1" />
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <Border Classes="pill" VerticalAlignment="Center" Padding="9,3">
                        <TextBlock Text="интерактивная лаборатория" Classes="tiny" />
                    </Border>
                </StackPanel>
                <TextBlock Text="Визуальные алгоритмы на графах: обходы, потоки, остовные деревья и кратчайшие пути"
                           Classes="muted" FontSize="11.5" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Classes="pill" Padding="10,5">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Width="7" Height="7" CornerRadius="4" Background="#34D399" VerticalAlignment="Center" />
                        <TextBlock Text="4 задания · 4 алгоритма" Classes="tiny" />
                    </StackPanel>
                </Border>
                <Border Classes="pill" Padding="10,5">
                    <TextBlock Text="Avalonia 12 · .NET 9" Classes="tiny" />
                </Border>
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1" x:Name="MainTabs" Margin="18,2,18,0" Padding="0" Height="800">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="22" Height="22" CornerRadius="7" Background="#0E7490" VerticalAlignment="Center">
                            <TextBlock Text="1" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Обход графа" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <views:GraphEditorView />
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="22" Height="22" CornerRadius="7" Background="#5B21B6" VerticalAlignment="Center">
                            <TextBlock Text="2" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Максимальный поток" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <views:MaxFlowView />
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="22" Height="22" CornerRadius="7" Background="#1D4D3A" VerticalAlignment="Center">
                            <TextBlock Text="3" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Остовное дерево" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <views:MstView />
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="22" Height="22" CornerRadius="7" Background="#0C4A6E" VerticalAlignment="Center">
                            <TextBlock Text="4" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Кратчайший путь" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <views:ShortestPathView />
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Height="24" Background="#070C16" BorderBrush="#162238" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto" Margin="20,0">
                <TextBlock Text="GraphLab · сохранение в JSON/CSV · анимации и журнал шагов"
                           Classes="tiny" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Пробел — пуск/пауза · Del — удалить · Esc — отмена"
                           Classes="tiny" VerticalAlignment="Center" />
            </Grid>
        </Border>
        </Grid>
    </Viewbox>
</Window>
