<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GraphLab.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="BgDeepColor">#070B14</Color>
            <Color x:Key="AccentColor">#22D3EE</Color>
            <Color x:Key="SystemAccentColor">#0EA5E9</Color>
            <Color x:Key="SystemAccentColorLight1">#38BDF8</Color>
            <Color x:Key="SystemAccentColorLight2">#7DD3FC</Color>
            <Color x:Key="SystemAccentColorLight3">#BAE6FD</Color>
            <Color x:Key="SystemAccentColorDark1">#0284C7</Color>
            <Color x:Key="SystemAccentColorDark2">#0369A1</Color>
            <Color x:Key="SystemAccentColorDark3">#075985</Color>
            <Color x:Key="TextColor">#E8EFFC</Color>
            <SolidColorBrush x:Key="BgDeepBrush" Color="#070B14" />
            <SolidColorBrush x:Key="CardBrush" Color="#111A2C" />
            <SolidColorBrush x:Key="CardSoftBrush" Color="#0E1626" />
            <SolidColorBrush x:Key="LineBrush" Color="#22304A" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E8EFFC" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#8FA2C4" />
            <SolidColorBrush x:Key="AccentBrush" Color="#22D3EE" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#0E7490" />
            <SolidColorBrush x:Key="VioletBrush" Color="#A78BFA" />
            <SolidColorBrush x:Key="GreenBrush" Color="#34D399" />
            <SolidColorBrush x:Key="AmberBrush" Color="#FBBF24" />
            <SolidColorBrush x:Key="RedBrush" Color="#F87171" />
            <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#22D3EE" Offset="0" />
                <GradientStop Color="#818CF8" Offset="0.55" />
                <GradientStop Color="#F472B6" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="CardGradientBrush" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#172136" Offset="0" />
                <GradientStop Color="#0F1726" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="CanvasGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#0B1424" Offset="0" />
                <GradientStop Color="#080D17" Offset="1" />
            </LinearGradientBrush>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark" Accent="#0EA5E9" />
            </FluentTheme.Palettes>
        </FluentTheme>

        <Style Selector="Window">
            <Setter Property="FontFamily" Value="Inter" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="UserControl">
            <Setter Property="FontFamily" Value="Inter" />
        </Style>

        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        </Style>
        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,monospace" />
        </Style>
        <Style Selector="TextBlock.h1">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.h2">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="1.2" />
            <Setter Property="Foreground" Value="#B8C7E4" />
        </Style>
        <Style Selector="TextBlock.tiny">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        </Style>
        <Style Selector="TextBlock.metric">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#C9F7FF" />
        </Style>
        <Style Selector="TextBlock.journalText">
            <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,monospace" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="Foreground" Value="#B9C9E5" />
            <Setter Property="Margin" Value="0,0,0,9" />
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource CardGradientBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style Selector="Border.taskHeader">
            <Setter Property="Background" Value="{StaticResource CardGradientBrush}" />
            <Setter Property="BorderBrush" Value="#25395A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="18,14" />
        </Style>
        <Style Selector="Border.canvasCard">
            <Setter Property="Background" Value="{StaticResource CanvasGradientBrush}" />
            <Setter Property="BorderBrush" Value="#22304A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.numberBadge">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="#0E7490" />
            <Setter Property="BorderBrush" Value="#22D3EE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.pill">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Background" Value="#152238" />
            <Setter Property="BorderBrush" Value="#2A3C5D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
        <Style Selector="Border.hintPill">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Background" Value="#CC0A1220" />
            <Setter Property="BorderBrush" Value="#33476B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
        </Style>
        <Style Selector="Border.separator">
            <Setter Property="Background" Value="#22304A" />
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="8,4" />
        </Style>

        <Style Selector="Button">
            <Setter Property="Background" Value="#1A2740" />
            <Setter Property="Foreground" Value="#E8EFFC" />
            <Setter Property="BorderBrush" Value="#2A3C5D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#22324F" />
            <Setter Property="BorderBrush" Value="#3A547D" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#0E7490" />
            <Setter Property="BorderBrush" Value="#22D3EE" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="#0891B2" />
        </Style>
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#2A3C5D" />
            <Setter Property="Foreground" Value="#B9C9E5" />
        </Style>
        <Style Selector="Button.ghost:pointerover">
            <Setter Property="Background" Value="#111C2E" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#2A1520" />
            <Setter Property="BorderBrush" Value="#7F2C3F" />
            <Setter Property="Foreground" Value="#FCA5A5" />
        </Style>
        <Style Selector="Button.danger:pointerover">
            <Setter Property="Background" Value="#3A1B29" />
        </Style>
        <Style Selector="Button.icon">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.small">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>

        <Style Selector="ToggleButton.mode">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#A9B9D8" />
            <Setter Property="BorderBrush" Value="#2A3C5D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="ToggleButton.mode:checked">
            <Setter Property="Background" Value="#123548" />
            <Setter Property="Foreground" Value="#C9F7FF" />
            <Setter Property="BorderBrush" Value="#22D3EE" />
        </Style>
        <Style Selector="ToggleButton.mode:pointerover">
            <Setter Property="Background" Value="#182740" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="#0C1423" />
            <Setter Property="BorderBrush" Value="#263755" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#0C1423" />
            <Setter Property="BorderBrush" Value="#263755" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="Background" Value="#0C1423" />
            <Setter Property="BorderBrush" Value="#263755" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="#B9C9E5" />
        </Style>

        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#8FA2C4" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="MinHeight" Value="44" />
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="#E8EFFC" />
        </Style>
        <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
            <Setter Property="Background" Value="#22D3EE" />
        </Style>
        <Style Selector="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="TabItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="TabItem /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="TabItem:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="#142138" />
            <Setter Property="BorderBrush" Value="#2C4266" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Slider">
            <Setter Property="MinHeight" Value="20" />
        </Style>
        <Style Selector="ToolTip">
            <Setter Property="Background" Value="#152238" />
            <Setter Property="Foreground" Value="#E8EFFC" />
            <Setter Property="BorderBrush" Value="#2A3C5D" />
        </Style>
        <Style Selector="Expander">
            <Setter Property="Foreground" Value="#B9C9E5" />
        </Style>
    </Application.Styles>
</Application>
