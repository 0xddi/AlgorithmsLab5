<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GraphLab.Controls"
             x:Class="GraphLab.Views.ShortestPathView">
    <Grid RowDefinitions="Auto,*" Margin="18,12,18,14">
        <Border Classes="taskHeader">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Classes="numberBadge" Background="#0C4A6E" BorderBrush="#38BDF8">
                    <TextBlock Text="04" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,16,0" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Кратчайший путь" Classes="h1" FontSize="22" />
                        <Border Classes="pill" VerticalAlignment="Center">
                            <TextBlock Text="Дейкстра" Classes="tiny" Foreground="#C9F7FF" />
                        </Border>
                    </StackPanel>
                    <TextBlock Classes="muted" TextWrapping="Wrap"
                               Text="Выберите две вершины — начало и конец маршрута. Алгоритм Дейкстры пошагово вычислит расстояния, покажет таблицу оценок, дерево кратчайших путей и итоговый маршрут с анимацией." />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="5" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Classes="pill"><TextBlock Text="выбор вершин пользователем" Classes="tiny" /></Border>
                    <Border Classes="pill"><TextBlock Text="таблица расстояний и предков" Classes="tiny" /></Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,418" Margin="0,12,0,0">
            <Grid RowDefinitions="Auto,*">
                <Border Classes="card" Padding="10">
                    <controls:GraphToolbox x:Name="Toolbar" />
                </Border>

                <Border Grid.Row="1" Classes="canvasCard" Margin="0,10,0,0">
                    <Grid>
                        <controls:GraphView x:Name="GraphCanvas" />
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Classes="hintPill" Background="#B80A1220">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Border Width="9" Height="9" CornerRadius="5" Background="#FBBF24" VerticalAlignment="Center" />
                                    <TextBlock Text="текущая" Classes="tiny" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Border Width="9" Height="9" CornerRadius="5" Background="#34D399" VerticalAlignment="Center" />
                                    <TextBlock Text="d известно" Classes="tiny" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Border Width="9" Height="9" CornerRadius="5" Background="#A78BFA" VerticalAlignment="Center" />
                                    <TextBlock Text="в очереди" Classes="tiny" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Border Width="9" Height="9" CornerRadius="5" Background="#22D3EE" VerticalAlignment="Center" />
                                    <TextBlock Text="кратчайший путь" Classes="tiny" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" Classes="hintPill" MaxWidth="780">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="●" Foreground="#22D3EE" VerticalAlignment="Center" />
                                <TextBlock x:Name="CanvasHint" Text="Выберите начало и конец маршрута." Classes="tiny" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Column="1" RowDefinitions="*,Auto,Auto" Margin="12,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="10">
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Text="ПАРАМЕТРЫ МАРШРУТА" Classes="sectionTitle" />
                                <Grid ColumnDefinitions="*,*">
                                    <StackPanel Spacing="4" Margin="0,0,5,0">
                                        <TextBlock Text="Начальная вершина" Classes="tiny" />
                                        <ComboBox x:Name="StartBox">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Label}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4" Margin="5,0,0,0">
                                        <TextBlock Text="Конечная вершина" Classes="tiny" />
                                        <ComboBox x:Name="TargetBox">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Label}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                                <Button x:Name="BuildPathButton" Classes="primary" Content="Найти кратчайший путь"
                                        HorizontalAlignment="Stretch" Padding="14,9" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button x:Name="SaveGraphButton" Classes="ghost small" Content="💾 Сохранить граф" />
                                    <Button x:Name="LoadGraphButton" Classes="ghost small" Content="📂 Загрузить граф" />
                                </StackPanel>
                                <Expander Header="Как работает Дейкстра? (теория)" FontSize="12">
                                    <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="18"
                                               Text="Алгоритм поддерживает для каждой вершины текущую оценку расстояния d(v) и предыдущую вершину на лучшем известном пути. На каждом шаге выбирается незафиксированная вершина с минимальным d, её расстояние окончательно фиксируется, а все исходящие рёбра ослабляются: если d(u) + w(u,v) &lt; d(v), оценка обновляется. Когда цель зафиксирована, путь восстанавливается по ссылкам на предыдущие вершины. Алгоритм требует неотрицательных весов. Сложность — O(V²), с двоичной кучей — O((V+E) log V)." />
                                </Expander>
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <Grid RowDefinitions="Auto,Auto,Auto">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="ТАБЛИЦА РАССТОЯНИЙ" Classes="sectionTitle" />
                                    <TextBlock x:Name="TableInfo" Grid.Column="1" Classes="tiny" Text="нет данных" />
                                </Grid>
                                <Grid Grid.Row="1" ColumnDefinitions="0.8*,0.7*,0.8*,1.5*" Margin="0,8,0,4">
                                    <TextBlock Text="Вершина" Classes="tiny" Foreground="#7E93B5" />
                                    <TextBlock Grid.Column="1" Text="d(v)" Classes="tiny" Foreground="#7E93B5" />
                                    <TextBlock Grid.Column="2" Text="Пред." Classes="tiny" Foreground="#7E93B5" />
                                    <TextBlock Grid.Column="3" Text="Статус" Classes="tiny" Foreground="#7E93B5" />
                                </Grid>
                                <Border Grid.Row="2" Background="#0A1220" BorderBrush="#1E2C45" BorderThickness="1"
                                        CornerRadius="9" Padding="8,6" Height="172">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="DistanceItems">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="0.8*,0.7*,0.8*,1.5*" Margin="0,2">
                                                        <TextBlock Text="{Binding A}" Classes="mono" FontSize="11" />
                                                        <TextBlock Grid.Column="1" Text="{Binding B}" Classes="mono" FontSize="11" Foreground="#C9F7FF" />
                                                        <TextBlock Grid.Column="2" Text="{Binding C}" Classes="mono" FontSize="11" Foreground="#8FA2C4" />
                                                        <TextBlock Grid.Column="3" Text="{Binding D}" FontSize="10.5" Foreground="#8FA2C4" TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Border>

                        <controls:GraphInspector x:Name="Inspector" />
                    </StackPanel>
                </ScrollViewer>

                <controls:JournalPanel Grid.Row="1" x:Name="Journal" Height="160" Margin="0,10,0,0" />

                <Border Grid.Row="2" Classes="card" Margin="0,10,0,0">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="УПРАВЛЕНИЕ ДЕМОНСТРАЦИЕЙ" Classes="sectionTitle" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Classes="pill" Padding="8,2">
                                <TextBlock Text="анимация" Classes="tiny" Foreground="#C9F7FF" />
                            </Border>
                        </Grid>
                        <controls:PlaybackBar x:Name="Playback" />
                        <Border Background="#0A1220" BorderBrush="#1E2C45" BorderThickness="1" CornerRadius="9" Padding="10,7">
                            <StackPanel Spacing="2">
                                <TextBlock Text="РЕЗУЛЬТАТ" Classes="tiny" Foreground="#7E93B5" />
                                <TextBlock x:Name="ResultText" Text="Выберите вершины и постройте маршрут." Classes="metric" TextWrapping="Wrap" FontSize="12.5" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="NoticeText" Classes="tiny" TextWrapping="Wrap" IsVisible="False" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
