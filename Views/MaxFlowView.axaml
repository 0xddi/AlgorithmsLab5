<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GraphLab.Controls"
             x:Class="GraphLab.Views.MaxFlowView">
    <Grid RowDefinitions="Auto,*" Margin="18,12,18,14">
        <Border Classes="taskHeader">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Classes="numberBadge" Background="#5B21B6" BorderBrush="#A78BFA">
                    <TextBlock Text="02" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,16,0" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Максимальный поток" Classes="h1" FontSize="22" />
                        <Border Classes="pill" VerticalAlignment="Center">
                            <TextBlock Text="Эдмондс–Карп" Classes="tiny" Foreground="#DDD2FF" />
                        </Border>
                    </StackPanel>
                    <TextBlock Classes="muted" TextWrapping="Wrap"
                               Text="Транспортная сеть с пропускными способностями. Редактируйте узлы и дуги, выбирайте источник и сток, а затем наблюдайте, как алгоритм шаг за шагом находит дополняющие пути и увеличивает поток до максимума." />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="5" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Classes="pill"><TextBlock Text="транспортная сеть · capacities" Classes="tiny" /></Border>
                    <Border Classes="pill"><TextBlock Text="метка ребра: поток / пропускная способность" Classes="tiny" /></Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,418" Margin="0,12,0,0">
            <Grid RowDefinitions="Auto,*">
                <Border Classes="card" Padding="10">
                    <controls:GraphToolbox x:Name="Toolbar" />
                </Border>

                <Border Grid.Row="1" Classes="canvasCard" Margin="0,10,0,0">
                    <Grid>
                        <controls:GraphView x:Name="GraphCanvas" />
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Classes="hintPill" Background="#B80A1220">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Border Width="9" Height="9" CornerRadius="5" Background="#34D399" VerticalAlignment="Center" />
                                    <TextBlock Text="источник" Classes="tiny" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Border Width="9" Height="9" CornerRadius="5" Background="#F87171" VerticalAlignment="Center" />
                                    <TextBlock Text="сток" Classes="tiny" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Border Width="9" Height="9" CornerRadius="5" Background="#22D3EE" VerticalAlignment="Center" />
                                    <TextBlock Text="дополняющий путь" Classes="tiny" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Border Width="9" Height="9" CornerRadius="5" Background="#A78BFA" VerticalAlignment="Center" />
                                    <TextBlock Text="обратная дуга" Classes="tiny" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" Classes="hintPill" MaxWidth="760">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="●" Foreground="#A78BFA" VerticalAlignment="Center" />
                                <TextBlock x:Name="CanvasHint" Text="Выберите источник и сток, затем постройте поток." Classes="tiny" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Column="1" RowDefinitions="*,Auto,Auto" Margin="12,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="10">
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Text="ПАРАМЕТРЫ ПОТОКА" Classes="sectionTitle" />
                                <Grid ColumnDefinitions="*,*">
                                    <StackPanel Spacing="4" Margin="0,0,5,0">
                                        <TextBlock Text="Источник (S)" Classes="tiny" />
                                        <ComboBox x:Name="SourceBox">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Label}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4" Margin="5,0,0,0">
                                        <TextBlock Text="Сток (T)" Classes="tiny" />
                                        <ComboBox x:Name="SinkBox">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Label}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                                <Button x:Name="BuildFlowButton" Classes="primary" Content="Найти максимальный поток"
                                        HorizontalAlignment="Stretch" Padding="14,9" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button x:Name="SaveGraphButton" Classes="ghost small" Content="💾 Сохранить сеть" />
                                    <Button x:Name="LoadGraphButton" Classes="ghost small" Content="📂 Загрузить сеть" />
                                </StackPanel>
                                <Border Background="#0A1220" BorderBrush="#1E2C45" BorderThickness="1" CornerRadius="9" Padding="10,7">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="КАК ЧИТАТЬ МЕТКИ" Classes="tiny" Foreground="#7E93B5" />
                                        <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="11.5" LineHeight="17"
                                                   Text="На каждой дуге показано «поток / пропускная способность». Зелёные дуги входят в текущий дополняющий путь, фиолетовые пунктирные — обратные дуги остаточной сети, красные — рёбра минимального разреза." />
                                    </StackPanel>
                                </Border>
                                <Expander Header="Как работает Эдмондс–Карп? (теория)" FontSize="12">
                                    <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="18"
                                               Text="Алгоритм строит остаточную сеть: у каждой дуги есть прямой остаток cap − flow и обратная дуга с остатком flow, позволяющая «отменить» часть потока. С помощью BFS ищется кратчайший по числу дуг дополняющий путь из источника в сток, поток вдоль пути увеличивается на минимальный остаток (узкое место). Процесс повторяется, пока путь существует. По теореме Форда–Фалкерсона полученный поток максимален и равен пропускной способности минимального разреза. Сложность — O(V·E²)." />
                                </Expander>
                            </StackPanel>
                        </Border>

                        <controls:GraphInspector x:Name="Inspector" />
                    </StackPanel>
                </ScrollViewer>

                <controls:JournalPanel Grid.Row="1" x:Name="Journal" Height="160" Margin="0,10,0,0" />

                <Border Grid.Row="2" Classes="card" Margin="0,10,0,0">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="УПРАВЛЕНИЕ ДЕМОНСТРАЦИЕЙ" Classes="sectionTitle" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Classes="pill" Padding="8,2">
                                <TextBlock Text="анимация" Classes="tiny" Foreground="#DDD2FF" />
                            </Border>
                        </Grid>
                        <controls:PlaybackBar x:Name="Playback" />
                        <Border Background="#0A1220" BorderBrush="#1E2C45" BorderThickness="1" CornerRadius="9" Padding="10,7">
                            <StackPanel Spacing="2">
                                <TextBlock Text="РЕЗУЛЬТАТ" Classes="tiny" Foreground="#7E93B5" />
                                <TextBlock x:Name="ResultText" Text="Постройте поток, чтобы увидеть значение." Classes="metric" TextWrapping="Wrap" FontSize="12.5" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="NoticeText" Classes="tiny" TextWrapping="Wrap" IsVisible="False" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
