<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GraphLab.Controls"
             x:Class="GraphLab.Views.MstView">
    <Grid RowDefinitions="Auto,*" Margin="18,12,18,14">
        <Border Classes="taskHeader">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Classes="numberBadge" Background="#1D4D3A" BorderBrush="#34D399">
                    <TextBlock Text="03" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,16,0" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Минимальное остовное дерево" Classes="h1" FontSize="22" />
                        <Border Classes="pill" VerticalAlignment="Center">
                            <TextBlock Text="Краскал · Прим" Classes="tiny" Foreground="#CFFCE8" />
                        </Border>
                    </StackPanel>
                    <TextBlock Classes="muted" TextWrapping="Wrap"
                               Text="Редактор взвешенного графа и пошаговое построение остовного дерева. Сравните Краскала и Прима, включите режим максимального дерева, сохраните граф и готовое дерево в отдельные файлы." />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="5" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Classes="pill"><TextBlock Text="жадные алгоритмы · union-find" Classes="tiny" /></Border>
                    <Border Classes="pill"><TextBlock Text="сохранение графа и MST" Classes="tiny" /></Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,428" Margin="0,12,0,0">
            <Grid RowDefinitions="Auto,*">
                <Border Classes="card" Padding="10">
                    <controls:GraphToolbox x:Name="Toolbar" />
                </Border>

                <Border Grid.Row="1" Classes="canvasCard" Margin="0,10,0,0">
                    <Grid>
                        <controls:GraphView x:Name="GraphCanvas" />
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Classes="hintPill" Background="#B80A1220">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Border Width="9" Height="9" CornerRadius="5" Background="#FBBF24" VerticalAlignment="Center" />
                                    <TextBlock Text="рассматриваем" Classes="tiny" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Border Width="9" Height="9" CornerRadius="5" Background="#34D399" VerticalAlignment="Center" />
                                    <TextBlock Text="в дереве" Classes="tiny" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Border Width="9" Height="9" CornerRadius="5" Background="#F87171" VerticalAlignment="Center" />
                                    <TextBlock Text="отклонено (цикл)" Classes="tiny" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Border Width="9" Height="9" CornerRadius="5" Background="#A78BFA" VerticalAlignment="Center" />
                                    <TextBlock Text="старт Прима" Classes="tiny" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" Classes="hintPill" MaxWidth="780">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="●" Foreground="#34D399" VerticalAlignment="Center" />
                                <TextBlock x:Name="CanvasHint" Text="Постройте остовное дерево, чтобы увидеть шаги." Classes="tiny" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Column="1" RowDefinitions="*,Auto,Auto" Margin="12,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="10">
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Text="ПАРАМЕТРЫ ОСТОВНОГО ДЕРЕВА" Classes="sectionTitle" />
                                <Grid ColumnDefinitions="*,*">
                                    <StackPanel Spacing="4" Margin="0,0,5,0">
                                        <TextBlock Text="Алгоритм" Classes="tiny" />
                                        <ComboBox x:Name="AlgorithmBox" SelectedIndex="0">
                                            <ComboBoxItem Content="Краскал (Kruskal)" />
                                            <ComboBoxItem Content="Прим (Prim)" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4" Margin="5,0,0,0">
                                        <TextBlock Text="Старт (только для Прима)" Classes="tiny" />
                                        <ComboBox x:Name="StartBox">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Label}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                                <CheckBox x:Name="MaximumCheckBox" Content="Максимальное остовное дерево (по весу)"
                                          ToolTip.Tip="Сортировка рёбер по убыванию / выбор максимального ребра разреза" />
                                <Button x:Name="BuildTreeButton" Classes="primary" Content="Построить остовное дерево"
                                        HorizontalAlignment="Stretch" Padding="14,9" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button x:Name="SaveGraphButton" Classes="ghost small" Content="💾 Граф" />
                                    <Button x:Name="LoadGraphButton" Classes="ghost small" Content="📂 Граф" />
                                    <Button x:Name="SaveTreeButton" Classes="ghost small" Content="💾 Дерево (MST)" />
                                    <Button x:Name="LoadTreeButton" Classes="ghost small" Content="📂 Дерево (MST)" />
                                </StackPanel>
                                <Expander Header="Как работают Краскал и Прим? (теория)" FontSize="12">
                                    <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="18"
                                               Text="Краскал сортирует все рёбра по весу и добавляет очередное ребро, если его концы лежат в разных компонентах связности (проверка цикла через систему непересекающихся множеств, union-find). Прим начинает с одной вершины и на каждом шаге добавляет минимальное ребро, пересекающее границу уже построенного дерева. Оба алгоритма жадные и дают минимальное остовное дерево для связного графа; при выборе рёбер в обратном порядке получается максимальное остовное дерево. Сложность Краскала — O(E log E), Прима с простым выбором — O(V²)." />
                                </Expander>
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <Grid RowDefinitions="Auto,Auto,Auto">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="ВЫБРАННЫЕ РЁБРА" Classes="sectionTitle" />
                                    <TextBlock x:Name="TreeCountText" Grid.Column="1" Classes="tiny" Text="0 рёбер" />
                                </Grid>
                                <Grid Grid.Row="1" ColumnDefinitions="1.4*,0.7*,1*" Margin="0,8,0,4">
                                    <TextBlock Text="Ребро" Classes="tiny" Foreground="#7E93B5" />
                                    <TextBlock Grid.Column="1" Text="Вес" Classes="tiny" Foreground="#7E93B5" />
                                    <TextBlock Grid.Column="2" Text="Сумма" Classes="tiny" Foreground="#7E93B5" />
                                </Grid>
                                <Border Grid.Row="2" Background="#0A1220" BorderBrush="#1E2C45" BorderThickness="1"
                                        CornerRadius="9" Padding="8,6" Height="158">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="TreeItems">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="1.4*,0.7*,1*" Margin="0,2">
                                                        <TextBlock Text="{Binding A}" Classes="mono" FontSize="11" />
                                                        <TextBlock Grid.Column="1" Text="{Binding B}" Classes="mono" FontSize="11" Foreground="#CFFCE8" />
                                                        <TextBlock Grid.Column="2" Text="{Binding C}" Classes="mono" FontSize="11" Foreground="#8FA2C4" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Border>

                        <controls:GraphInspector x:Name="Inspector" />
                    </StackPanel>
                </ScrollViewer>

                <controls:JournalPanel Grid.Row="1" x:Name="Journal" Height="160" Margin="0,10,0,0" />

                <Border Grid.Row="2" Classes="card" Margin="0,10,0,0">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="УПРАВЛЕНИЕ ДЕМОНСТРАЦИЕЙ" Classes="sectionTitle" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Classes="pill" Padding="8,2">
                                <TextBlock Text="анимация" Classes="tiny" Foreground="#CFFCE8" />
                            </Border>
                        </Grid>
                        <controls:PlaybackBar x:Name="Playback" />
                        <Border Background="#0A1220" BorderBrush="#1E2C45" BorderThickness="1" CornerRadius="9" Padding="10,7">
                            <StackPanel Spacing="2">
                                <TextBlock Text="ИТОГ" Classes="tiny" Foreground="#7E93B5" />
                                <TextBlock x:Name="ResultText" Text="Постройте дерево, чтобы увидеть суммарный вес." Classes="metric" TextWrapping="Wrap" FontSize="12.5" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="NoticeText" Classes="tiny" TextWrapping="Wrap" IsVisible="False" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
