<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GraphLab.Controls.GraphInspector">
    <Border Classes="card">
        <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="ИНСПЕКТОР" Classes="sectionTitle" VerticalAlignment="Center" />
                <Border Grid.Column="1" Classes="pill" Padding="8,2">
                    <TextBlock x:Name="SelectionKind" Text="ничего не выбрано" Classes="tiny" />
                </Border>
            </Grid>

            <TextBlock x:Name="EmptyText" Classes="muted" TextWrapping="Wrap"
                       Text="Кликните по вершине или ребру на холсте, чтобы изменить метку, вес, пропускную способность или удалить элемент." />

            <StackPanel x:Name="NodePanel" IsVisible="False" Spacing="7">
                <TextBlock x:Name="NodeTitle" Classes="metric" />
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox x:Name="NodeLabelBox" PlaceholderText="Метка вершины" VerticalAlignment="Center" />
                    <Button x:Name="ApplyNodeButton" Grid.Column="1" Classes="primary small" Content="Применить" Margin="8,0,0,0" />
                </Grid>
                <TextBlock x:Name="NodeInfo" Classes="tiny" />
            </StackPanel>

            <StackPanel x:Name="EdgePanel" IsVisible="False" Spacing="7">
                <TextBlock x:Name="EdgeTitle" Classes="metric" />
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock x:Name="EdgeValueLabel" Text="Вес" Classes="muted" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <NumericUpDown x:Name="EdgeValueBox" Grid.Column="1" Minimum="0.1" Maximum="99999" Increment="1"
                                   FormatString="0.##" Value="1" />
                    <Button x:Name="ApplyEdgeButton" Grid.Column="2" Classes="primary small" Content="Применить" Margin="8,0,0,0" />
                </Grid>
                <TextBlock x:Name="EdgeInfo" Classes="tiny" />
            </StackPanel>

            <Button x:Name="DeleteButton" Classes="danger small" Content="Удалить выбранное" IsVisible="False" />
        </StackPanel>
    </Border>
</UserControl>
